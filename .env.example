# =============================================================================
# Hotel System — copy to .env on server, then fill values marked CHANGE_ME
# Local:  cp .env.example .env && php artisan key:generate
# Prod:   set APP_DEBUG=false, APP_URL=api subdomain, FRONTEND_URL=app subdomain
# =============================================================================

APP_NAME="Hotel System"
APP_ENV=production
APP_KEY=base64:UmqofxSMFNDG6sunX5DZjEdysNKuYO8WYuFmlgIAWu4=
APP_DEBUG=false
APP_URL=https://hotelsystemback.osus.network

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Primary database (reservations, rooms, users, accounting, …)
# cPanel: use localhost (not 127.0.0.1) if connection fails
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osusnetw_hotelsystem
DB_USERNAME=osusnetw_abd
DB_PASSWORD=abd0988929807@

# -----------------------------------------------------------------------------
# Secondary database — Client model uses connection "mysql2"
# On shared hosting you may use the SAME database as DB_* above if all tables
# are in one MySQL database; otherwise create a second DB and fill DB2_*.
# -----------------------------------------------------------------------------
DB2_HOST=localhost
DB2_PORT=3306
DB2_DATABASE=osusnetw_hotelUsers
DB2_USERNAME=osusnetw_abd
DB2_PASSWORD=abd0988929807@

# -----------------------------------------------------------------------------
# Angular frontend URL (CORS) — must match app subdomain exactly (https)
# Example: https://app.yourdomain.com
# -----------------------------------------------------------------------------
FRONTEND_URL=https://hotelsystem.osus.network

BROADCAST_DRIVER=reverb
# Production: redis (shared cache across PHP-FPM workers). Local without Redis: file
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
# Production: redis (report exports, queued broadcasts). Local dev: sync
QUEUE_CONNECTION=redis
# Production VPS (shared sessions across workers): SESSION_DRIVER=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Optional: set true on HTTPS production
SESSION_SECURE_COOKIE=true

# Production: set strong password then run php artisan hotel:ensure-admin
# HOTEL_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# API rate limits (requests per minute)
# Authenticated SPA users need a higher ceiling (property page loads many endpoints).
# -----------------------------------------------------------------------------
API_RATE_LIMIT_AUTHENTICATED=600
API_RATE_LIMIT_GUEST=120
API_RATE_LIMIT_LOGIN=20

# -----------------------------------------------------------------------------
# Demo / seed (local development)
# DEMO_LIGHT=1          → used by demo:setup --light only
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Reports (shared-host cron: php artisan reports:process-pending --limit=5)
# -----------------------------------------------------------------------------
REPORT_PAGE_SIZE=50
REPORT_PREVIEW_LIMIT=500
# Direct PDF/Excel/CSV download cap (larger reports → email export or narrower filters)
REPORT_MAX_DIRECT_DOWNLOAD_ROWS=40
REPORT_EXPORT_RETENTION_DAYS=7
REPORT_MAX_PENDING_PER_USER=3

# -----------------------------------------------------------------------------
# Mail — required only for email report delivery
# cPanel: use your domain SMTP or host's mail server
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=abdulroufoyoun@osus.network
MAIL_PORT=587
MAIL_USERNAME=noreply@osus.network
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@osus.network"
MAIL_FROM_NAME="${APP_NAME}"
# -----------------------------------------------------------------------------
# Local development overrides (uncomment for XAMPP / artisan serve)
# -----------------------------------------------------------------------------
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://127.0.0.1:8001
# FRONTEND_URL=http://127.0.0.1:4200
# DB_HOST=127.0.0.1
# DB_DATABASE=hotel_booking
# DB_USERNAME=root
# DB_PASSWORD=
# DB2_HOST=127.0.0.1
# DB2_DATABASE=clientCheckinBooking
# DB2_USERNAME=root
# DB2_PASSWORD=
# LOG_LEVEL=debug
# CACHE_DRIVER=file
# QUEUE_CONNECTION=sync
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS=hello@example.com

# -----------------------------------------------------------------------------
# Laravel Reverb (real-time WebSocket)
# Local: REVERB_HOST=127.0.0.1 REVERB_PORT=8080 REVERB_SCHEME=http
# Prod:  reverse-proxy WSS to REVERB_SERVER_PORT; set REVERB_SCHEME=https
# Generate keys: php artisan reverb:install (or copy from .env after install)
# -----------------------------------------------------------------------------
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080

# -----------------------------------------------------------------------------
# Redis (cache + queues — complements Reverb; does NOT replace WebSocket realtime)
# Install Redis on server; use separate DB indexes for cache vs queue when possible.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# -----------------------------------------------------------------------------
# ZATCA e-invoicing (Integration Sandbox first)
# Onboard: php artisan zatca:sandbox-onboard
# Status:  php artisan zatca:sandbox-status
# Postman: php artisan zatca:sandbox-postman --show-secrets
# Sandbox OTP examples: 123345, 111111, 222222
# -----------------------------------------------------------------------------
ZATCA_ENVIRONMENT=sandbox
ZATCA_ENABLED=true
ZATCA_AUTO_REPORT_ON_CHECKOUT=true
ZATCA_OTP=123345
ZATCA_VAT_NUMBER=300000000000003
ZATCA_ORG_NAME="Hotel System Test"
ZATCA_ORG_UNIT="Riyadh Branch"
ZATCA_CSR_COMMON_NAME="Hotel System EGS"
ZATCA_INVOICE_TYPE=1100
ZATCA_LOCATION=Riyadh
ZATCA_INDUSTRY=Hospitality
# ZATCA_CSR_TEMPLATE=TSTZATCA-Code-Signing
