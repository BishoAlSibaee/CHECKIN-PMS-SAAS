# =============================================================================
# Hotel System — TRIAL/DEMO on shared hosting (cPanel + SSH).
# Copy to .env on the server, fill every CHANGE_ME, then:
#   composer install --no-dev --optimize-autoloader
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan db:seed --class=AdminSeeder
#   php artisan passport:keys
#   php artisan hotel:ensure-admin --password='CHANGE_ME (8+ chars)'
# Cron (cPanel Cron Jobs, every minute):
#   * * * * * php /home/CPANEL_USER/demo-backend/artisan schedule:run >> /dev/null 2>&1
# =============================================================================

APP_NAME="Hotel System (Demo)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME-api.yourdomain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# cPanel: use "localhost" (not 127.0.0.1) if connection fails.
# DB name/user are usually prefixed "cpaneluser_..." — set from cPanel > MySQL Databases.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Secondary connection (Client model) — fine to reuse the SAME database as above
# on shared hosting if you only have one DB available.
DB2_HOST=localhost
DB2_PORT=3306
DB2_DATABASE=CHANGE_ME
DB2_USERNAME=CHANGE_ME
DB2_PASSWORD=CHANGE_ME

# Must match the Angular demo subdomain exactly (https).
FRONTEND_URL=https://CHANGE_ME.yourdomain.com

# No persistent Reverb process possible on shared hosting — leave broadcasting
# off; the frontend's environment.demo.ts falls back to HTTP polling instead.
BROADCAST_DRIVER=log

# No Redis on shared hosting — "file" needs no extra migration/table and is
# fine for a single-server demo (unlike "database", which needs a cache table).
CACHE_STORE=file
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# sync = jobs run inline immediately, no worker/supervisor needed — fine for
# low-traffic demo use.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

API_RATE_LIMIT_AUTHENTICATED=600
API_RATE_LIMIT_GUEST=120
API_RATE_LIMIT_LOGIN=20

REPORT_PAGE_SIZE=50
REPORT_PREVIEW_LIMIT=500
REPORT_MAX_DIRECT_DOWNLOAD_ROWS=40
REPORT_EXPORT_RETENTION_DAYS=7
REPORT_MAX_PENDING_PER_USER=3

# Optional — only needed for emailed report exports. Leave MAIL_PASSWORD blank
# to have Laravel log mail instead of sending (safe default for a demo).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# ZATCA — sandbox ONLY for a demo. Never point a trial environment at
# production ZATCA; it would attempt to report real tax invoices.
# -----------------------------------------------------------------------------
ZATCA_ENVIRONMENT=sandbox
ZATCA_ENABLED=true
ZATCA_AUTO_REPORT_ON_CHECKOUT=true
ZATCA_OTP=123345
ZATCA_VAT_NUMBER=300000000000003
ZATCA_ORG_NAME="Hotel System Demo"
ZATCA_ORG_UNIT="Demo Branch"
ZATCA_CSR_COMMON_NAME="Hotel System EGS Demo"
ZATCA_INVOICE_TYPE=1100
ZATCA_LOCATION=Riyadh
ZATCA_INDUSTRY=Hospitality

# -----------------------------------------------------------------------------
# Leave disabled for a demo — no real GRMS devices, OTA channels, SMS/WhatsApp
# provider keys belong in a trial environment.
# -----------------------------------------------------------------------------
GRMS_ENABLED=false
CHANNEX_ENABLED=false
